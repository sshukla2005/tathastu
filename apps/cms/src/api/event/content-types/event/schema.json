{
  "kind": "collectionType",
  "collectionName": "events",
  "info": {
    "singularName": "event",
    "pluralName": "events",
    "displayName": "Event",
    "description": "Past events, each with their own slug-addressable gallery detail page"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "title", "required": true },
    "summary": { "type": "text" },
    "coverImage": { "type": "media", "multiple": false, "required": false, "allowedTypes": ["images"] },
    "eventDate": { "type": "date" },
    "order": { "type": "integer", "default": 0 },
    "galleryHeading": { "type": "string" },
    "galleryText": { "type": "text" },
    "galleryTall1": { "type": "media", "multiple": false, "required": false, "allowedTypes": ["images"] },
    "gallerySmall1": { "type": "media", "multiple": false, "required": false, "allowedTypes": ["images"] },
    "gallerySmall2": { "type": "media", "multiple": false, "required": false, "allowedTypes": ["images"] },
    "galleryWide": { "type": "media", "multiple": false, "required": false, "allowedTypes": ["images"] },
    "galleryCenter": { "type": "media", "multiple": false, "required": false, "allowedTypes": ["images"] },
    "galleryTall2": { "type": "media", "multiple": false, "required": false, "allowedTypes": ["images"] },
    "galleryBottomA": { "type": "media", "multiple": false, "required": false, "allowedTypes": ["images"] },
    "galleryBottomB": { "type": "media", "multiple": false, "required": false, "allowedTypes": ["images"] }
  }
}
