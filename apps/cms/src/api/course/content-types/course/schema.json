{
  "kind": "collectionType",
  "collectionName": "courses",
  "info": {
    "singularName": "course",
    "pluralName": "courses",
    "displayName": "Course",
    "description": "Academy courses & videos, shared by the Academy hub teaser and the full Courses & Videos catalog page"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "title", "required": true },
    "image": { "type": "media", "multiple": false, "required": false, "allowedTypes": ["images"] },
    "description": { "type": "text" },
    "duration": { "type": "string" },
    "badge": { "type": "string" },
    "isVideo": { "type": "boolean", "default": false },
    "category": { "type": "string" },
    "level": { "type": "enumeration", "enum": ["Beginner", "Intermediate"], "default": "Beginner" },
    "order": { "type": "integer", "default": 0 },
    "details": {
      "type": "dynamiczone",
      "components": ["course-details.standard", "course-details.houdini"],
      "min": 0,
      "max": 1
    }
  }
}
