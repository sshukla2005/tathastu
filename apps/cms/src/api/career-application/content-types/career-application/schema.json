{
  "kind": "collectionType",
  "collectionName": "career_applications",
  "info": {
    "singularName": "career-application",
    "pluralName": "career-applications",
    "displayName": "Career Application",
    "description": "Job application submissions from the site-wide Apply Now form"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": { "type": "string", "required": true },
    "email": { "type": "email", "required": true },
    "position": { "type": "string", "required": true },
    "experience": { "type": "string" },
    "qualification": { "type": "string" },
    "message": { "type": "text" },
    "cv": { "type": "media", "multiple": false, "required": false, "allowedTypes": ["files", "images"] },
    "status": {
      "type": "enumeration",
      "enum": ["New", "Reviewed", "Shortlisted", "Rejected", "Hired"],
      "default": "New"
    }
  }
}
