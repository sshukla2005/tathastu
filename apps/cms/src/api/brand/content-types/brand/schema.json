{
  "kind": "collectionType",
  "collectionName": "brands",
  "info": {
    "singularName": "brand",
    "pluralName": "brands",
    "displayName": "Brand",
    "description": "Partner/product brands showcased within an Industry (e.g. Adobe, SideFX, Dell)"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "name", "required": true },
    "category": { "type": "enumeration", "enum": ["Software", "Hardware"], "default": "Software" },
    "shortDescription": { "type": "text" },
    "logo": { "type": "media", "multiple": false, "required": false, "allowedTypes": ["images"] },
    "order": { "type": "integer", "default": 0 },
    "industry": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::industry.industry",
      "inversedBy": "brands"
    },
    "heroImage": { "type": "media", "multiple": false, "required": false, "allowedTypes": ["images"] },
    "aboutDescription": { "type": "text" },
    "apps": { "type": "component", "repeatable": true, "component": "shared.icon-card" },
    "showcases": { "type": "component", "repeatable": true, "component": "shared.app-showcase" },
    "clientLogos": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::client-logo.client-logo"
    }
  }
}
